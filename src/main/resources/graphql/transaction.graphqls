enum TransactionType {
    BUY
    SELL
}

type Transaction {
    id: ID!
    type: TransactionType!
    quantity: BigDecimal!
    price: BigDecimal!
    date: Date!
    asset: Asset!
}

extend type Query {
    transactions(page:Int = 0, size:Int = 10):TransactionPage!
}

type TransactionPage {
    content: [Transaction!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

input TransactionInput {
    type: TransactionType!
    quantity: BigDecimal!
    price: BigDecimal!
    date: Date!
    assetTicker: String!
}

extend type Mutation {
    addTransaction(newTransaction:TransactionInput!): Transaction!
    deleteTransaction(id : ID!): Boolean!
}