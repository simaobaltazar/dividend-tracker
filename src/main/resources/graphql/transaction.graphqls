enum TransactionType {
    BUY
    SELL
}

type Transaction {
    id: ID!
    type: TransactionType!
    quantity: BigDecimal!
    price: BigDecimal!
    date: Date!
    asset: Asset!
}

extend type Query {
    transactions: [Transaction!]!
}

input TransactionInput {
    type: TransactionType!
    quantity: BigDecimal!
    price: BigDecimal!
    date: Date!
    assetTicker: String!
}

extend type Mutation {
    addTransaction(newTransaction:TransactionInput!): Transaction!
    deleteTransaction(id : ID!): Boolean!
}